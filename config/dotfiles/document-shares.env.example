# Copy to ~/.config/dotfiles/document-shares.env for your laptop.

# Reuses the same server and credentials style as media-shares.env.
SMB_HOST=192.168.1.10
# Optional. If omitted, mount-smb-share uses ~/.smb/media-server.
# SMB_CREDENTIALS_FILE=$HOME/.smb/home-server

# Server Samba share names.
DOCUMENTS_1_SHARE=Documents_1
DOCUMENTS_2_SHARE=Documents_2

# Local laptop mount points.
DOCUMENTS_1_MOUNT=/mnt/documents_1
DOCUMENTS_2_MOUNT=/mnt/documents_2

# Safety: mount the HDD mirror read-only on the laptop.
DOCUMENTS_2_CLIENT_READONLY=1
