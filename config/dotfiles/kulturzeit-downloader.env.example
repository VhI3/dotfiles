# Copy to ~/.config/dotfiles/kulturzeit-downloader.env for your laptop.

KULTURZEIT_DOWNLOADER_DIR=$HOME/dev/kulturzeit-downloader
KULTURZEIT_CONFIG_FILE=$HOME/dev/kulturzeit-downloader/config.toml

# Jellyfin Series share mounted by mount-media-shares.
KULTURZEIT_DOWNLOAD_DIR=/mnt/tv_show/Kulturzeit
KULTURZEIT_DOWNLOAD_MOUNT_POINT=/mnt/tv_show

# If /mnt/tv_show is not mounted, kulturzeit-downloader will try mount-media-shares first.
KULTURZEIT_AUTO_MOUNT_MEDIA=1
